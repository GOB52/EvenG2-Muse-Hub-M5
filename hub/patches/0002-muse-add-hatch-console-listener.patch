+/*
+ * One listener for the "@chat" lines: called with the line's type, its fields
+ * (the JSON members, "" if none) and the whole text (NULL if none), on the task
+ * that prints it, before the line goes to the console. NULL removes it.
+ */
+typedef void (*muse_hatch_listener_t)(const char *type, const char *fields, const char *text);
+void muse_hatch_set_listener(muse_hatch_listener_t listener);
 /* Undoes the escapes in a line typed at the console (\n \r \t \\) in place; returns the length. */
