+/* Lowercase hex and dashes only: the ID goes into JSON bodies as it is. */
+static bool session_id_ok(const char *id)
+{
+    const size_t n = id ? strlen(id) : 0;
+    if (n == 0 || n >= SESSION_ID_MAX) {
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        const char c = id[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || c == '-')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+extern "C" void muse_hatch_set_session_id(const char *id)
+{
+    if (s_connected) {
+        ESP_LOGE(TAG, "side chat can't be set while connected; using the main chat");
+        return;
+    }
+    if (s_session_claimed.exchange(true)) {
+        ESP_LOGW(TAG, "side chat already set; ignoring another");
+        return;
+    }
+    if (!session_id_ok(id)) {
+        s_session_claimed.store(false);   /* released: a correct call can still follow */
+        ESP_LOGE(TAG, "side chat ID must be lowercase hex and dashes, under %d chars; using the main chat",
+                 SESSION_ID_MAX);
+        return;
+    }
+    strlcpy(s_session_id, id, sizeof(s_session_id));
+    s_session_set.store(true, std::memory_order_release);
+    ESP_LOGI(TAG, "side chat %s", s_session_id);
+}
