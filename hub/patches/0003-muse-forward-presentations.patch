+/* A widget (a list, a map, ...) to the console: its id, kind, texts and data, without the HTML. */
+static void forward_presentation(cJSON *payload)
+{
+    const char *id = cJSON_GetStringValue(cJSON_GetObjectItem(payload, "id"));
+    if (!id || !id[0]) {
+        return;
+    }
+    cJSON *out = cJSON_CreateObject();
+    static const char *const KEYS[] = {"id", "kind", "display_text", "fallback_text"};
+    for (const char *key : KEYS) {
+        const char *v = cJSON_GetStringValue(cJSON_GetObjectItem(payload, key));
+        if (v) {
+            cJSON_AddStringToObject(out, key, v);
+        }
+    }
+    cJSON *data = cJSON_Duplicate(cJSON_GetObjectItem(payload, "data"), true);
+    if (data) {
+        cJSON_DeleteItemFromObject(data, "html");
+        cJSON_DeleteItemFromObject(cJSON_GetObjectItem(data, "typed_data"), "html");
+        cJSON_AddItemToObject(out, "data", data);
+    }
+    char *json = cJSON_PrintUnformatted(out);
+    cJSON_Delete(out);
+    if (json) {
+        muse_hatch_console("presentation", json, "\"id\":\"%.80s\"", id);
+        cJSON_free(json);
+    }
+}
